<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sudoku — Kuntal Chakraborty</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=Cormorant+Garamond:wght@300;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #111114;
      color: #e0e0e0;
      font-family: 'DM Sans', sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2rem 1rem 3rem;
    }

    nav {
      width: 100%;
      max-width: 560px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2.5rem;
    }
    .nav-logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 600;
      color: #fff;
      text-decoration: none;
      letter-spacing: 0.02em;
    }
    .nav-back {
      font-size: 0.8rem;
      font-weight: 400;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #4a9eca;
      text-decoration: none;
      transition: color 0.2s;
    }
    .nav-back:hover { color: #7dbfe3; }

    .game-wrap {
      width: 100%;
      max-width: 520px;
      background: #1a1a1e;
      border-radius: 16px;
      padding: 28px;
    }

    .game-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
    }
    .game-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.8rem;
      font-weight: 300;
      color: #fff;
      letter-spacing: 0.04em;
    }
    .game-timer {
      font-size: 14px;
      color: #4a9eca;
      font-weight: 500;
      background: #0d2a3a;
      padding: 6px 14px;
      border-radius: 8px;
      letter-spacing: 0.05em;
    }

    .diff-row {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
    }
    .diff-btn {
      flex: 1;
      padding: 8px;
      font-size: 12px;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      border-radius: 8px;
      border: 1.5px solid #2a2a2e;
      background: #22222a;
      color: #888;
      cursor: pointer;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      transition: all 0.15s;
    }
    .diff-btn.active { background: #4a9eca; color: #fff; border-color: #4a9eca; }
    .diff-btn:hover:not(.active) { border-color: #4a9eca; color: #4a9eca; }

    .status-bar {
      text-align: center;
      font-size: 13px;
      color: #4a9eca;
      min-height: 20px;
      margin-bottom: 10px;
      font-weight: 500;
    }

    .board {
      display: grid;
      grid-template-columns: repeat(9, 1fr);
      gap: 2px;
      background: #4a9eca;
      border: 2.5px solid #4a9eca;
      border-radius: 6px;
      overflow: hidden;
      margin-bottom: 14px;
    }
    .cell {
      background: #22222a;
      width: 100%;
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: clamp(12px, 2.5vw, 18px);
      font-weight: 500;
      cursor: pointer;
      color: #e0e0e0;
      transition: background 0.1s;
      user-select: none;
      border: none;
      outline: none;
    }
    .cell.given    { color: #fff; background: #2a2a35; cursor: default; }
    .cell.selected { background: #0d2a3a; }
    .cell.highlight{ background: #1e2a32; }
    .cell.error    { color: #e24b4a; }
    .cell.correct  { color: #4a9eca; }
    .cell.box-right  { border-right: 2px solid #4a9eca; }
    .cell.box-bottom { border-bottom: 2px solid #4a9eca; }

    .mistakes-row {
      font-size: 13px;
      color: #666;
      text-align: center;
      margin-bottom: 14px;
    }
    .mistakes-row span { color: #e24b4a; font-weight: 500; }

    .numpad {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 8px;
      margin-bottom: 14px;
    }
    .num-btn {
      padding: 10px 4px;
      text-align: center;
      font-size: 17px;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      background: #22222a;
      border: 1.5px solid #2a2a2e;
      border-radius: 8px;
      cursor: pointer;
      color: #e0e0e0;
      transition: all 0.12s;
    }
    .num-btn:hover { background: #0d2a3a; border-color: #4a9eca; color: #4a9eca; }
    .num-btn.erase { font-size: 12px; color: #888; letter-spacing: 0.04em; }

    .actions {
      display: flex;
      gap: 8px;
    }
    .action-btn {
      flex: 1;
      padding: 10px;
      font-size: 13px;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      border-radius: 8px;
      border: 1.5px solid #2a2a2e;
      background: #22222a;
      color: #aaa;
      cursor: pointer;
      transition: all 0.15s;
      letter-spacing: 0.04em;
    }
    .action-btn:hover { border-color: #4a9eca; color: #4a9eca; }
    .action-btn.primary { background: #4a9eca; color: #fff; border-color: #4a9eca; }
    .action-btn.primary:hover { background: #2a6d99; border-color: #2a6d99; }

    .win-overlay {
      display: none;
      text-align: center;
      padding: 2rem 0 1rem;
    }
    .win-overlay.show { display: block; }
    .win-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      font-weight: 300;
      color: #4a9eca;
      margin-bottom: 0.5rem;
    }
    .win-sub {
      font-size: 0.9rem;
      color: #888;
      margin-bottom: 1.5rem;
    }

    @media (max-width: 420px) {
      .game-wrap { padding: 18px; }
      .num-btn { font-size: 14px; padding: 8px 2px; }
    }
  </style>
</head>
<body>

<nav>
  <a class="nav-logo" href="index.html">KC</a>
  <a class="nav-back" href="index.html">← Back to Portfolio</a>
</nav>

<div class="game-wrap">
  <div class="game-header">
    <h1 class="game-title">Sudoku</h1>
    <div class="game-timer" id="timer">00:00</div>
  </div>

  <div class="diff-row">
    <button class="diff-btn active" id="btn-easy"   onclick="startGame('easy')">Easy</button>
    <button class="diff-btn"        id="btn-medium" onclick="startGame('medium')">Medium</button>
    <button class="diff-btn"        id="btn-hard"   onclick="startGame('hard')">Hard</button>
  </div>

  <div class="status-bar" id="status"></div>
  <div class="board" id="board"></div>
  <div class="mistakes-row">Mistakes: <span id="mistakes">0</span> / 3</div>
  <div class="numpad" id="numpad"></div>
  <div class="actions">
    <button class="action-btn" onclick="getHint()">Hint</button>
    <button class="action-btn" onclick="checkBoard()">Check</button>
    <button class="action-btn primary" onclick="newGame()">New Game</button>
  </div>
</div>

<script>
  let puzzle = [], solution = [], selected = null;
  let timerInterval = null, seconds = 0, mistakes = 0;
  let difficulty = 'easy', gameActive = false;

  const difficulties = { easy: 36, medium: 46, hard: 54 };

  function shuffle(a) {
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function isValid(board, r, c, n) {
    if (board[r].includes(n)) return false;
    if (board.some(row => row[c] === n)) return false;
    const br = Math.floor(r / 3) * 3, bc = Math.floor(c / 3) * 3;
    for (let i = 0; i < 3; i++)
      for (let j = 0; j < 3; j++)
        if (board[br + i][bc + j] === n) return false;
    return true;
  }

  function findEmpty(board) {
    for (let r = 0; r < 9; r++)
      for (let c = 0; c < 9; c++)
        if (!board[r][c]) return [r, c];
    return null;
  }

  function solveSudoku(board) {
    const empty = findEmpty(board);
    if (!empty) return true;
    const [r, c] = empty;
    for (let n of shuffle([1,2,3,4,5,6,7,8,9])) {
      if (isValid(board, r, c, n)) {
        board[r][c] = n;
        if (solveSudoku(board)) return true;
        board[r][c] = 0;
      }
    }
    return false;
  }

  function generatePuzzle(diff) {
    const board = Array.from({ length: 9 }, () => Array(9).fill(0));
    solveSudoku(board);
    const sol = board.map(r => [...r]);
    const remove = difficulties[diff];
    const cells = shuffle([...Array(81).keys()]);
    for (let i = 0; i < remove; i++) {
      board[Math.floor(cells[i] / 9)][cells[i] % 9] = 0;
    }
    return { puzzle: board, solution: sol };
  }

  function startGame(diff) {
    difficulty = diff;
    ['easy', 'medium', 'hard'].forEach(d => document.getElementById('btn-' + d).classList.remove('active'));
    document.getElementById('btn-' + diff).classList.add('active');
    const gen = generatePuzzle(diff);
    puzzle = gen.puzzle.map(r => r.map(v => ({ val: v, given: v !== 0, user: null })));
    solution = gen.solution;
    selected = null; mistakes = 0; gameActive = true;
    document.getElementById('mistakes').textContent = '0';
    document.getElementById('status').textContent = '';
    clearInterval(timerInterval); seconds = 0; updateTimer();
    timerInterval = setInterval(() => { seconds++; updateTimer(); }, 1000);
    renderBoard();
    renderNumpad();
  }

  function updateTimer() {
    const m = Math.floor(seconds / 60).toString().padStart(2, '0');
    const s = (seconds % 60).toString().padStart(2, '0');
    document.getElementById('timer').textContent = m + ':' + s;
  }

  function renderBoard() {
    const board = document.getElementById('board');
    board.innerHTML = '';
    for (let r = 0; r < 9; r++) {
      for (let c = 0; c < 9; c++) {
        const cell = document.createElement('div');
        cell.className = 'cell';
        const d = puzzle[r][c];
        if (d.given) {
          cell.classList.add('given');
          cell.textContent = d.val;
        } else if (d.user) {
          cell.textContent = d.user;
          cell.classList.add(d.user === solution[r][c] ? 'correct' : 'error');
        }
        if (selected && selected[0] === r && selected[1] === c) {
          cell.classList.add('selected');
        } else if (selected) {
          const [sr, sc] = selected;
          const sv = puzzle[sr][sc].given ? puzzle[sr][sc].val : puzzle[sr][sc].user;
          const cv = d.given ? d.val : d.user;
          const sameBox = Math.floor(r/3)===Math.floor(sr/3) && Math.floor(c/3)===Math.floor(sc/3);
          if (r === sr || c === sc || sameBox) cell.classList.add('highlight');
          if (sv && cv && sv === cv) cell.classList.add('highlight');
        }
        if (c === 2 || c === 5) cell.classList.add('box-right');
        if (r === 2 || r === 5) cell.classList.add('box-bottom');
        cell.addEventListener('click', () => {
          if (!gameActive) return;
          selected = [r, c];
          renderBoard();
        });
        board.appendChild(cell);
      }
    }
  }

  function renderNumpad() {
    const pad = document.getElementById('numpad');
    pad.innerHTML = '';
    for (let n = 1; n <= 9; n++) {
      const btn = document.createElement('div');
      btn.className = 'num-btn';
      btn.textContent = n;
      btn.addEventListener('click', () => inputNum(n));
      pad.appendChild(btn);
    }
    const erase = document.createElement('div');
    erase.className = 'num-btn erase';
    erase.textContent = 'Erase';
    erase.addEventListener('click', () => inputNum(0));
    pad.appendChild(erase);
  }

  function inputNum(n) {
    if (!selected || !gameActive) return;
    const [r, c] = selected;
    if (puzzle[r][c].given) return;
    if (n === 0) { puzzle[r][c].user = null; renderBoard(); return; }
    puzzle[r][c].user = n;
    if (n !== solution[r][c]) {
      mistakes++;
      document.getElementById('mistakes').textContent = mistakes;
      if (mistakes >= 3) {
        gameActive = false;
        clearInterval(timerInterval);
        document.getElementById('status').textContent = 'Game over! Start a new game.';
      }
    }
    renderBoard();
    checkWin();
  }

  function checkWin() {
    for (let r = 0; r < 9; r++)
      for (let c = 0; c < 9; c++) {
        const d = puzzle[r][c];
        const val = d.given ? d.val : d.user;
        if (val !== solution[r][c]) return;
      }
    gameActive = false;
    clearInterval(timerInterval);
    const m = Math.floor(seconds / 60).toString().padStart(2, '0');
    const s = (seconds % 60).toString().padStart(2, '0');
    document.getElementById('status').textContent = 'Solved! Time: ' + m + ':' + s;
  }

  function checkBoard() {
    if (!gameActive) return;
    let errors = 0;
    for (let r = 0; r < 9; r++)
      for (let c = 0; c < 9; c++)
        if (puzzle[r][c].user && puzzle[r][c].user !== solution[r][c]) errors++;
    document.getElementById('status').textContent = errors ? errors + ' mistake(s) found' : 'Looking good!';
    setTimeout(() => { if (gameActive) document.getElementById('status').textContent = ''; }, 2000);
  }

  function getHint() {
    if (!gameActive) return;
    const empties = [];
    for (let r = 0; r < 9; r++)
      for (let c = 0; c < 9; c++)
        if (!puzzle[r][c].given && puzzle[r][c].user !== solution[r][c]) empties.push([r, c]);
    if (!empties.length) return;
    const [r, c] = empties[Math.floor(Math.random() * empties.length)];
    puzzle[r][c].user = solution[r][c];
    selected = [r, c];
    renderBoard();
    checkWin();
  }

  function newGame() { startGame(difficulty); }

  document.addEventListener('keydown', e => {
    if (!gameActive || !selected) return;
    const n = parseInt(e.key);
    if (n >= 1 && n <= 9) { inputNum(n); return; }
    if (e.key === 'Backspace' || e.key === 'Delete') { inputNum(0); return; }
    const [r, c] = selected;
    if (e.key === 'ArrowUp'    && r > 0) { selected = [r-1, c]; renderBoard(); }
    if (e.key === 'ArrowDown'  && r < 8) { selected = [r+1, c]; renderBoard(); }
    if (e.key === 'ArrowLeft'  && c > 0) { selected = [r, c-1]; renderBoard(); }
    if (e.key === 'ArrowRight' && c < 8) { selected = [r, c+1]; renderBoard(); }
  });

  startGame('easy');
</script>
</body>
</html>
